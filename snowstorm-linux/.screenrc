shell "/usr/bin/zsh"
startup_message off
vbell off
hardstatus alwayslastline
hardstatus string '%{gk}[ %{G}%H %{g}][%= %{wk}%?%-Lw%?%{=b kR}(%{W}%n*%f %t%?(%u)%?%{=b kR})%{= kw}%?%+Lw%?%?%= %{g}]%{=y C}[%d/%m %c]%{W}'
termcapinfo xterm*|rxvt*|kterm*|Eterm* ti@:te@
bind l stuff "screen -X chdir \$PWD;screen^M"
bind ^l stuff "screen -X chdir \$PWD;screen^M"
